<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- A single-line, chip-like "tap to open a picker" control - shows
         the current selection plus a dropdown caret, used in place of a
         full-width Spinner where several of these need to sit side by
         side without dominating the screen (see ProgressionActivity's
         member/axis/currency row). -->
    <style name="ProgressionDropdownTab">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/dropdown_tab_background</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawableEnd">@drawable/ic_dropdown_caret</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- One "Label      Value" row in the Returns detail screen's Risk
         &amp; relative performance section - see ReturnsDetailActivity. -->
    <style name="MetricRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <!-- A small, visually distinct "tap to change/act" control - same
         elevated chip look as ProgressionDropdownTab (reusing
         dropdown_tab_background) but WITHOUT the dropdown caret, since
         this is for actions/toggles ("Compare", "Names", "Change",
         "Set date range") rather than a picker showing a current
         selection. Exists because several such controls across the app
         were plain, low-contrast text links that a person could easily
         miss as tappable at all - a confirmed real complaint ("Compare"
         and "Names" on Returns, "Set date range"/"Change" on a fund's
         own graph page were called out as "almost invisible"). Apply
         this anywhere a control lets the person modify or navigate to
         modify something, so what's tappable is obvious at a glance
         without needing to explore the screen first. -->
    <style name="ActionChip">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/dropdown_tab_background</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
