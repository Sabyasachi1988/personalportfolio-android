<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Groups Progression together with the new Returns screen (fund
         and benchmark historical returns table - see ReturnsActivity)
         under the same bottom-nav "Progress" destination, the same
         pill-tab pattern Allocation already uses. Deliberately NOT a
         ViewPager2 like Allocation's - Progression's chart gesture code
         (pinch-zoom/pan, daily-range refetch) is intricate and recently
         stabilized, so this just launches ReturnsActivity as its own
         screen on tap rather than risk restructuring Progression's
         internals to host it as a swipeable page. "Progression" tapped
         while already here is a no-op. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/progressionSectionTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/tab_bar_background"
        android:padding="4dp"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/tab_indicator_pill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabRippleColor="@null"
        app:tabPaddingTop="6dp"
        app:tabPaddingBottom="6dp"
        app:tabTextColor="@color/colorNeutral"
        app:tabSelectedTextColor="@color/colorOnPrimary"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progression" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Returns" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Three compact dropdown "tabs" side by side, replacing
                 three stacked full-width Spinners - each shows its
                 current selection and opens a popup menu on tap, same
                 information density as before in a fraction of the
                 vertical space. No separate screen title here - the
                 bottom nav tab already reads "Progress", so repeating
                 it as a heading was pure redundancy taking up a full
                 line for no added information. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progressionMemberTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/progressionAxisTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/progressionCurrencyTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/progressionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="@color/colorNeutral" />

            <!-- Point-in-time detail card, driven by the scrubber below -->
            <include
                android:id="@+id/progressionStatsCard"
                layout="@layout/include_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:background="@color/colorProgressionInvested" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Invested"
                    android:textSize="12sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="20dp"
                    android:background="@color/colorGain" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Value"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/progressionResetZoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Reset zoom ↺"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

            <com.saby.personalportfolio.ProgressionChartView
                android:id="@+id/progressionChart"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pinch to zoom (past ~6 months shows real daily detail) · drag to pan once zoomed · double-tap to reset"
                android:textSize="11sp"
                android:gravity="center"
                android:textColor="@color/colorNeutral" />

            <!-- Slider mirrors the chart's own drag-scrub, for finer/easier
                 control than dragging a thumb across a small chart area.
                 Custom drawables give it a much thicker, more grabbable
                 track+thumb than the stock thin SeekBar. -->
            <SeekBar
                android:id="@+id/progressionSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:progressDrawable="@drawable/progression_seekbar_track"
                android:thumb="@drawable/progression_seekbar_thumb"
                android:splitTrack="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
