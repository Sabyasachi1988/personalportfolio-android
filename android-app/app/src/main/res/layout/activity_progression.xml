<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Portfolio Progression"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Three compact dropdown "tabs" side by side, replacing
                 three stacked full-width Spinners - each shows its
                 current selection and opens a popup menu on tap, same
                 information density as before in a fraction of the
                 vertical space. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/progressionMemberTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/progressionAxisTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/progressionCurrencyTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/progressionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="14sp" />

            <!-- Answers "how much history am I even looking at" up front,
                 rather than only on touch - see ProgressionChartView's
                 doc comment for why this was added. -->
            <TextView
                android:id="@+id/progressionSpanText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <!-- Point-in-time detail card, driven by the scrubber below -->
            <include
                android:id="@+id/progressionStatsCard"
                layout="@layout/include_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:background="@color/colorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Invested"
                    android:textSize="12sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="20dp"
                    android:background="@color/colorGain" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Value"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/progressionResetZoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Reset zoom ↺"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

            <com.saby.personalportfolio.ProgressionChartView
                android:id="@+id/progressionChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pinch to zoom into a stretch of the chart · double-tap to reset"
                android:textSize="11sp"
                android:gravity="center"
                android:textColor="@color/colorNeutral" />

            <!-- Slider mirrors the chart's own drag-scrub, for finer/easier
                 control than dragging a thumb across a small chart area.
                 Custom drawables give it a much thicker, more grabbable
                 track+thumb than the stock thin SeekBar. -->
            <SeekBar
                android:id="@+id/progressionSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:progressDrawable="@drawable/progression_seekbar_track"
                android:thumb="@drawable/progression_seekbar_thumb"
                android:splitTrack="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
