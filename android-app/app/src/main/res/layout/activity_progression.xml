<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Groups Progression together with the new Returns screen (fund
         and benchmark historical returns table - see ReturnsActivity)
         under the same bottom-nav "Progress" destination, the same
         pill-tab pattern Allocation already uses. Deliberately NOT a
         ViewPager2 like Allocation's - Progression's chart gesture code
         (pinch-zoom/pan, daily-range refetch) is intricate and recently
         stabilized, so this just launches ReturnsActivity as its own
         screen on tap rather than risk restructuring Progression's
         internals to host it as a swipeable page. "Progression" tapped
         while already here is a no-op. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/progressionSectionTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/tab_bar_background"
        android:padding="4dp"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/tab_indicator_pill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabRippleColor="@null"
        app:tabPaddingTop="6dp"
        app:tabPaddingBottom="6dp"
        app:tabTextColor="@color/colorNeutral"
        app:tabSelectedTextColor="@color/colorOnPrimary"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progression" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Returns" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Three compact dropdown "tabs" side by side, replacing
                 three stacked full-width Spinners - each shows its
                 current selection and opens a popup menu on tap, same
                 information density as before in a fraction of the
                 vertical space. No separate screen title here - the
                 bottom nav tab already reads "Progress", so repeating
                 it as a heading was pure redundancy taking up a full
                 line for no added information. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progressionMemberTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/progressionAxisTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/progressionCurrencyTab"
                    style="@style/ProgressionDropdownTab"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/progressionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="@color/colorNeutral" />

            <!-- Compact point-in-time card (same child ids as the shared
                 include_stats_card, which is still used by other screens).
                 About 40% shorter, so the chart and its controls fit on the
                 first screen without scrolling. -->
            <include
                android:id="@+id/progressionStatsCard"
                layout="@layout/include_progression_stats_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Legend + Trades toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:background="@color/colorProgressionInvested" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Invested"
                    android:textSize="12sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/colorGain" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Value"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/progressionTradesToggle"
                    style="@style/ActionChip"
                    android:layout_width="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Range chips. "All" is the old Reset zoom, now an ordinary
                 chip instead of a fourth item squeezed into the legend row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progressionResetZoomButton"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="All" />

                <TextView
                    android:id="@+id/progressionZoom1M"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="1M" />

                <TextView
                    android:id="@+id/progressionZoom3M"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="3M" />

                <TextView
                    android:id="@+id/progressionZoom6M"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="6M" />

                <TextView
                    android:id="@+id/progressionZoom1Y"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="1Y" />

                <TextView
                    android:id="@+id/progressionZoom2Y"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="2Y" />

                <TextView
                    android:id="@+id/progressionZoomCustom"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1.7"
                    android:layout_marginEnd="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="Custom" />

            </LinearLayout>

            <com.saby.personalportfolio.ProgressionChartView
                android:id="@+id/progressionChart"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="8dp" />

            <!-- Slider mirrors the chart's own drag-scrub. -->
            <SeekBar
                android:id="@+id/progressionSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:progressDrawable="@drawable/progression_seekbar_track"
                android:thumb="@drawable/progression_seekbar_thumb"
                android:splitTrack="false" />

            <!-- What happened inside the stretch currently on screen.
                 Updates as the window is zoomed or dragged. Market gain
                 excludes money added - see WindowMath. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/progressionWindowCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/windowSummaryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/colorNeutral" />

                    <TextView
                        android:id="@+id/windowSummaryGain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Money added"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/windowSummaryNetInvested"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Max drawdown"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/windowSummaryDrawdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="XIRR"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/windowSummaryXirr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
