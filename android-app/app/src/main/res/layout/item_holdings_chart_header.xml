<?xml version="1.0" encoding="utf-8"?>
<!-- Tap anywhere in this header to see the full per-fund breakdown in an
     enlarged dialog (see DonutExpansionDialog) - replaces the old
     always-visible horizontally-scrolling chip legend, which truncated
     most fund names and left most chips off-screen at a glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/holdingsChartHeaderContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Portfolio by fund"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <com.saby.personalportfolio.DonutChartView
        android:id="@+id/perFundDonut"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tap to see full breakdown"
        android:textSize="12sp"
        android:textColor="@color/colorNeutral"
        android:gravity="center" />

</LinearLayout>
