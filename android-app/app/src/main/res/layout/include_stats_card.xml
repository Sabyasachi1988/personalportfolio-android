<?xml version="1.0" encoding="utf-8"?>
<!-- Shared portfolio-stats card, used by Dashboard, Holdings, and
     Progression so the "value / gain / invested / XIRR" summary looks
     identical everywhere rather than each screen having its own
     slightly-different card. Screens that don't use a particular line
     (e.g. Dashboard has no Invested line, Progression's Date line is
     unique to it) set that TextView's visibility to GONE in code -
     nothing here is screen-specific except which lines get populated. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/statsCardDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statsCardValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statsCardGain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Day / 1-Year (rolling) / Calendar-Year (YTD) gain lines,
             stacked - see MainActivity.showPeriodGains' doc comment for
             exactly what these mean (net of contributions during each
             window, not the same thing as statsCardGain's since-
             inception total above). Rupee amount is the PRIMARY figure
             here (not percent) - Saby's own preference: a rupee amount
             is more immediately meaningful at a glance than a bare
             percent, especially for Day where % alone barely moves.
             Default GONE - only Dashboard populates and shows this;
             Holdings/Progression, which also use this shared card,
             leave it hidden. -->
        <LinearLayout
            android:id="@+id/statsCardPeriodGainsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/statsCardPeriodGainDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/statsCardPeriodGainYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/statsCardPeriodGainCalendarYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <TextView
            android:id="@+id/statsCardInvested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textColor="@color/colorNeutral"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statsCardXirr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/colorNeutral" />

        <TextView
            android:id="@+id/statsCardCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="@color/colorNeutral"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
