<?xml version="1.0" encoding="utf-8"?>
<!-- Shared portfolio-stats card, used by Dashboard, Holdings, and
     Progression so the "value / gain / invested / XIRR" summary looks
     identical everywhere rather than each screen having its own
     slightly-different card. Screens that don't use a particular line
     (e.g. Dashboard has no Invested line, Progression's Date line is
     unique to it) set that TextView's visibility to GONE in code -
     nothing here is screen-specific except which lines get populated. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/statsCardDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statsCardValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statsCardGain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Compact rolling Day/Week/Month/Year gain strip - see
             MainActivity.showPeriodGains' doc comment for exactly what
             each figure means (net of contributions during the window,
             not the same thing as statsCardGain's since-inception
             total above). Default GONE - only Dashboard populates and
             shows this; Holdings/Progression, which also use this
             shared card, leave it hidden. -->
        <LinearLayout
            android:id="@+id/statsCardPeriodGainsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/statsCardPeriodGainDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/statsCardPeriodGainWeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/statsCardPeriodGainMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/statsCardPeriodGainYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <TextView
            android:id="@+id/statsCardInvested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textColor="@color/colorNeutral"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statsCardXirr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/colorNeutral" />

        <TextView
            android:id="@+id/statsCardCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="@color/colorNeutral"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
