<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/returnsRowName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/returnsRowTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_period_gain_chip" />

        </LinearLayout>

        <!-- Day and 1 Month - trailing only (see finance.TrailingReturn's
             doc comment on why sub-year tenures don't get a rolling
             distribution). Kept compact and separate from the table
             below, which is where the added trailing+rolling detail for
             the longer tenures lives - this was flagged as feeling
             congested when everything shared one dense grid; splitting
             the quick day-to-day glance from the deeper multi-year
             comparison gives each room to breathe. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <include layout="@layout/item_returns_cell" android:id="@+id/returnsCellDay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/item_returns_cell" android:id="@+id/returnsCellMonth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@color/colorNeutralBg" />

        <!-- Header row - SAME 3 columns (34dp label / weight-1 / weight-1)
             as each item_returns_tenure_row below, so "Trailing" and
             "Rolling" sit directly above their own column instead of one
             caption floating above the whole block while only the
             rolling column repeats its own label per row - that mismatch
             was exactly why the numbers looked unaligned with their
             labels. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View android:layout_width="34dp" android:layout_height="1dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Trailing"
                android:textSize="10sp"
                android:textColor="@color/colorNeutral"
                android:gravity="center" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Rolling"
                android:textSize="10sp"
                android:textColor="@color/colorNeutral"
                android:gravity="center" />
        </LinearLayout>

        <include layout="@layout/item_returns_tenure_row" android:id="@+id/returnsRowOneYear" />
        <include layout="@layout/item_returns_tenure_row" android:id="@+id/returnsRowThreeYear" />
        <include layout="@layout/item_returns_tenure_row" android:id="@+id/returnsRowFiveYear" />
        <include layout="@layout/item_returns_tenure_row" android:id="@+id/returnsRowTenYear" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
