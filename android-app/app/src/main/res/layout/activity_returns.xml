<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Returns"
        android:textSize="20sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/returnsScreenerButton"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Screener" />

            <TextView
                android:id="@+id/returnsCompareButton"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Compare" />

            <TextView
                android:id="@+id/returnsManageAdditionalFundsButton"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="+ Add funds" />

            <TextView
                android:id="@+id/returnsManageBenchmarksButton"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Benchmarks" />

            <TextView
                android:id="@+id/returnsManageNamesButton"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:text="Names" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="@color/colorNeutral"
        android:text="1Y/3Y/5Y/10Y show the median across every rolling window of that length in the fund's history, with the [worst, best] window range below it. Tap the card for its full price history." />

    <!-- One card at a time, picked below, rather than a long scrolling
         list - with 15+ funds and benchmarks combined, and each card
         grown to include the trailing+rolling table, a full list became
         a very long scroll for very little payoff (only 2-3 cards fit
         on screen at once). This also frees up room to show more detail
         per card later without making the list even longer. -->
    <TextView
        android:id="@+id/returnsPickerTab"
        style="@style/ProgressionDropdownTab"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/returnsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="14sp"
        android:textColor="@color/colorNeutral"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:fillViewport="true">

        <FrameLayout
            android:id="@+id/returnsCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
