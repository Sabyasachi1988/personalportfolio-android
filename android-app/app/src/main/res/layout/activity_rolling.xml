<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Same slim section switch as Progression. Progression and Returns open
         their own screens; this one is "Rolling". -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/rollingSectionTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/tab_bar_background"
        android:padding="3dp"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/tab_indicator_pill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabRippleColor="@null"
        app:tabPaddingTop="1dp"
        app:tabPaddingBottom="1dp"
        app:tabTextColor="@color/colorNeutral"
        app:tabSelectedTextColor="@color/colorOnPrimary"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progression" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Returns" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rolling" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/rollingStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/colorNeutral" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rollingModeMoney"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:textSize="12sp"
                    android:text="Your money (money-weighted)" />

                <TextView
                    android:id="@+id/rollingModeTime"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:text="Investments only (time-weighted)" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/rollingTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorNeutral" />

                    <TextView
                        android:id="@+id/rollingLatest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rollingLatestCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/colorNeutral" />

                    <TextView
                        android:id="@+id/rollingCompare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="11sp"
                        android:textColor="@color/colorNeutral" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Median"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/rollingMedian"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Worst"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/rollingWorst"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/rollingWorstDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="@color/colorNeutral" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Best"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/rollingBest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/rollingBestDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="@color/colorNeutral" />
                    </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Windows in profit"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/rollingPositive"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Windows measured"
                            android:textSize="11sp"
                            android:textColor="@color/colorNeutral" />

                        <TextView
                            android:id="@+id/rollingCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/rollingScrubText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.saby.personalportfolio.RollingChartView
                android:id="@+id/rollingChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rollingChip1M"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="1M" />

                <TextView
                    android:id="@+id/rollingChip3M"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="3M" />

                <TextView
                    android:id="@+id/rollingChip6M"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="6M" />

                <TextView
                    android:id="@+id/rollingChip1Y"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="1Y" />

                <TextView
                    android:id="@+id/rollingChip2Y"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="2Y" />

                <TextView
                    android:id="@+id/rollingChipCustom"
                    style="@style/ActionChip"
                    android:layout_width="0dp"
                    android:layout_weight="1.7"
                    android:layout_marginEnd="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textSize="12sp"
                    android:text="Custom" />

            </LinearLayout>

            <TextView
                android:id="@+id/rollingNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="11sp"
                android:textColor="@color/colorNeutral" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/rollingMemberTab"
            style="@style/ProgressionDropdownTab"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/rollingAxisTab"
            style="@style/ProgressionDropdownTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
