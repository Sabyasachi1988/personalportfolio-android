<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="Fetches full historical NAV (for Indian mutual fund holdings, via TigZig's AMFI-sourced data) and daily FX rates (via Frankfurter, ECB-sourced) for every foreign-currency account. This can take a little while the first time - each fund and each currency is one network call." />

        <Button
            android:id="@+id/runUpdateHistoryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Update Now" />

        <TextView
            android:id="@+id/updateHistoryStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
