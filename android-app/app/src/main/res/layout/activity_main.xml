<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personal Portfolio"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/dashboardMemberSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    android:id="@+id/dashboardStatsCard"
                    layout="@layout/include_stats_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Allocation"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Three compact donuts, side by side, swipeable - sized
                     so about 1.3 cards show at once as a hint that more
                     are off to the right, rather than three cramped tiny
                     donuts squeezed to fit the full screen width. -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingEnd="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="240dp"
                            android:layout_height="300dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Market Cap"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:minLines="2"
                                    android:maxLines="2" />

                                <com.saby.personalportfolio.DonutChartView
                                    android:id="@+id/dashboardDonutMarketCap"
                                    android:layout_width="110dp"
                                    android:layout_height="110dp"
                                    android:layout_marginTop="10dp" />

                                <com.saby.personalportfolio.DonutLegendView
                                    android:id="@+id/dashboardDonutLegendMarketCap"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="240dp"
                            android:layout_height="300dp"
                            android:layout_marginStart="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Indian vs. International"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:minLines="2"
                                    android:maxLines="2" />

                                <com.saby.personalportfolio.DonutChartView
                                    android:id="@+id/dashboardDonutOrigin"
                                    android:layout_width="110dp"
                                    android:layout_height="110dp"
                                    android:layout_marginTop="10dp" />

                                <com.saby.personalportfolio.DonutLegendView
                                    android:id="@+id/dashboardDonutLegendOrigin"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="240dp"
                            android:layout_height="300dp"
                            android:layout_marginStart="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Equity / Debt / Commodity"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:minLines="2"
                                    android:maxLines="2" />

                                <com.saby.personalportfolio.DonutChartView
                                    android:id="@+id/dashboardDonutClass"
                                    android:layout_width="110dp"
                                    android:layout_height="110dp"
                                    android:layout_marginTop="10dp" />

                                <com.saby.personalportfolio.DonutLegendView
                                    android:id="@+id/dashboardDonutLegendClass"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </HorizontalScrollView>

                <TextView
                    android:id="@+id/dashboardAllocationHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:gravity="center"
                    android:text="Swipe for more · tap Allocation below for target comparison and fund composition editing" />

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Settings (Backup / Theme)" />

                <!-- Spacer so the FAB never overlaps the last item -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="72dp" />

            </LinearLayout>

        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/importFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="28dp"
            android:contentDescription="Import CAS PDF"
            app:srcCompat="@drawable/ic_fab_add" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
