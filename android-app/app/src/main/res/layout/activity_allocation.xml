<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Pill-style segmented tabs with icons, swipeable via the
         ViewPager2 below (TabLayoutMediator keeps both in sync in
         either direction - tap OR swipe both work). -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/allocationTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/tab_bar_background"
        android:padding="4dp"
        app:tabBackground="@android:color/transparent"
        app:tabIndicator="@drawable/tab_indicator_pill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabRippleColor="@null"
        app:tabPaddingTop="6dp"
        app:tabPaddingBottom="6dp"
        app:tabTextColor="@color/colorNeutral"
        app:tabSelectedTextColor="@color/colorOnPrimary"
        app:tabIconTint="@color/tab_text_color"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/allocationViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
