<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/returnsDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/returnsDetailScrubbed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral" />

        <com.saby.personalportfolio.PriceHistoryChartView
            android:id="@+id/returnsDetailChart"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="16dp" />

        <!-- Independent scroller for the zoomed chart above - see
             ChartRangeScrubberView's doc comment: dragging on the chart
             itself already means "pan when zoomed", so this gives a
             second, separate way to move the visible window without
             risking nudging it while trying to just read a value.
             Hidden automatically whenever not zoomed (nothing to
             scroll independently of). -->
        <com.saby.personalportfolio.ChartRangeScrubberView
            android:id="@+id/returnsDetailChartScrubber"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Pinch to zoom, drag to pan, double-tap to reset"
                android:textSize="11sp"
                android:textColor="@color/colorNeutral" />

            <TextView
                android:id="@+id/returnsDetailSetDateRange"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:text="Set date range" />

        </LinearLayout>

        <TextView
            android:id="@+id/returnsDetailEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral"
            android:visibility="gone" />

        <!-- Metrics section: shown only for a FUND row (not a benchmark
             comparing against itself) once ComputeFundMetrics returns.
             See ReturnsDetailActivity.loadMetrics. -->
        <LinearLayout
            android:id="@+id/returnsDetailMetricsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/colorSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Risk &amp; relative performance"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/returnsDetailBenchmarkLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="@color/colorNeutral" />

                <TextView
                    android:id="@+id/returnsDetailChangeBenchmark"
                    style="@style/ActionChip"
                    android:layout_width="wrap_content"
                    android:text="Change" />

            </LinearLayout>

            <TextView
                android:id="@+id/returnsDetailMetricBeta"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricInfoRatio"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricUpCapture"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricDownCapture"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricMaxDrawdown"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricSharpe"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricSortino"
                style="@style/MetricRow" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
