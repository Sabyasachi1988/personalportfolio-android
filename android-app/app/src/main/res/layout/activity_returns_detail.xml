<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/returnsDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/returnsDetailScrubbed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral" />

        <!-- FrameLayout wrapper so the transaction-marker popup
             (returnsDetailMarkerPopup) overlays the chart instead of
             pushing it down/around - see AutoDismissPopupView's own
             doc comment for why an overlay, not an AlertDialog. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.saby.personalportfolio.PriceHistoryChartView
                android:id="@+id/returnsDetailChart"
                android:layout_width="match_parent"
                android:layout_height="280dp" />

            <com.saby.personalportfolio.AutoDismissPopupView
                android:id="@+id/returnsDetailMarkerPopup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp" />

        </FrameLayout>

        <!-- Independent scroller for the zoomed chart above - see
             ChartRangeScrubberView's doc comment: dragging on the chart
             itself already means "pan when zoomed", so this gives a
             second, separate way to move the visible window without
             risking nudging it while trying to just read a value.
             Hidden automatically whenever not zoomed (nothing to
             scroll independently of). -->
        <com.saby.personalportfolio.ChartRangeScrubberView
            android:id="@+id/returnsDetailChartScrubber"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="8dp" />

        <!-- Fixed range-preset shortcuts on top of the existing pinch-
             zoom/pan/scrubber - see ReturnsDetailActivity's range-preset
             wiring. A HorizontalScrollView, not a fixed row, since 6
             chips (3M/6M/1Y/2Y/3Y/Max) can be tight on a narrow phone
             screen at comfortable tap-target size. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/returnsDetailRangePresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Custom years input alongside the fixed presets above -
             "4.5 years, 1.5 years, whatever" was the exact ask, so this
             takes a free-typed decimal rather than another fixed chip. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/returnsDetailChartWindowYears"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Custom window, years (e.g. 4.5)"
                android:inputType="numberDecimal" />

            <TextView
                android:id="@+id/returnsDetailChartWindowYearsShow"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Show" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Pinch to zoom, drag to pan, double-tap to reset"
                android:textSize="11sp"
                android:textColor="@color/colorNeutral" />

            <TextView
                android:id="@+id/returnsDetailSetDateRange"
                style="@style/ActionChip"
                android:layout_width="wrap_content"
                android:text="Set date range" />

        </LinearLayout>

        <TextView
            android:id="@+id/returnsDetailEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral"
            android:visibility="gone" />

        <!-- Metrics section: shown only for a FUND row (not a benchmark
             comparing against itself) once ComputeFundMetrics returns.
             See ReturnsDetailActivity.loadMetrics. -->
        <LinearLayout
            android:id="@+id/returnsDetailMetricsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/colorSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Risk &amp; relative performance"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/returnsDetailBenchmarkLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="@color/colorNeutral" />

                <TextView
                    android:id="@+id/returnsDetailChangeBenchmark"
                    style="@style/ActionChip"
                    android:layout_width="wrap_content"
                    android:text="Change" />

            </LinearLayout>

            <!-- Metric cards (Beta/Info Ratio/Up-Down Capture/Max
                 Drawdown/Sharpe/Sortino) are built programmatically as
                 a 2-per-row grid of small cards - see
                 ReturnsDetailActivity.bindMetrics/buildMetricCardRows.
                 Chosen over 7 near-identical static XML blocks (or
                 <include> reused 7 times, which would create duplicate
                 view IDs within one tree - a real footgun findViewById
                 can't safely resolve) since every card is structurally
                 identical, just different label/value/color. -->
            <LinearLayout
                android:id="@+id/returnsDetailMetricsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
