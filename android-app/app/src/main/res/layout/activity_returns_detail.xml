<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/returnsDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/returnsDetailScrubbed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral" />

        <com.saby.personalportfolio.PriceHistoryChartView
            android:id="@+id/returnsDetailChart"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pinch to zoom, drag to pan, double-tap to reset"
            android:textSize="11sp"
            android:textColor="@color/colorNeutral" />

        <TextView
            android:id="@+id/returnsDetailEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="@color/colorNeutral"
            android:visibility="gone" />

        <!-- Metrics section: shown only for a FUND row (not a benchmark
             comparing against itself) once ComputeFundMetrics returns.
             See ReturnsDetailActivity.loadMetrics. -->
        <LinearLayout
            android:id="@+id/returnsDetailMetricsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/colorSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Risk &amp; relative performance"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/returnsDetailBenchmarkLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="@color/colorNeutral" />

                <TextView
                    android:id="@+id/returnsDetailChangeBenchmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change"
                    android:textSize="13sp"
                    android:textColor="@color/colorSecondary"
                    android:padding="4dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/returnsDetailMetricBeta"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricInfoRatio"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricUpCapture"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricDownCapture"
                style="@style/MetricRow" />

            <TextView
                android:id="@+id/returnsDetailMetricMaxDrawdown"
                style="@style/MetricRow" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
