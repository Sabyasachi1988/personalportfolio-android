<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Compare"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/comparisonPickButton"
            style="@style/ProgressionDropdownTab"
            android:layout_width="wrap_content"
            android:text="Pick funds/indices" />

    </LinearLayout>

    <!-- Graph (existing overlay chart) vs Table (new quantitative
         side-by-side comparison) - same two-button toggle pattern as
         ProgressionActivity's own daily/weekly toggle. Only one
         container below is visible at a time; both read from the SAME
         selectedSeriesIds selection made via comparisonPickButton
         above, so switching tabs never requires re-picking funds. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/comparisonTabGraph"
            style="@style/ActionChip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Graph" />

        <TextView
            android:id="@+id/comparisonTabTable"
            style="@style/ActionChip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Table" />

        <TextView
            android:id="@+id/comparisonCustomizeButton"
            style="@style/ActionChip"
            android:layout_width="wrap_content"
            android:text="Customize" />

    </LinearLayout>

    <!-- comparisonGraphContainer wraps ALL the existing graph UI
         unchanged - this whole block used to be directly in the
         root layout; nothing inside it changed, it is just now
         toggleable as a unit alongside the new table container. -->
    <LinearLayout
        android:id="@+id/comparisonGraphContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lock base date"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/comparisonLockSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/comparisonSetDateRange"
            style="@style/ActionChip"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Set date range" />

    </LinearLayout>

    <TextView
        android:id="@+id/comparisonScrubbed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="4dp"
        android:textSize="14sp"
        android:textColor="@color/colorOnSurface" />

    <com.saby.personalportfolio.OverlayChartView
        android:id="@+id/comparisonChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <!-- Independent scroller for the zoomed chart above - see
         ChartRangeScrubberView's doc comment. Hidden automatically
         whenever not zoomed. -->
    <com.saby.personalportfolio.ChartRangeScrubberView
        android:id="@+id/comparisonChartScrubber"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="8dp" />

    <!-- Fixed range-preset shortcuts on top of the existing pinch-
         zoom/pan/scrubber - same as ReturnsDetailActivity's own chart.
         A HorizontalScrollView since 6 chips can be tight on a narrow
         phone screen at comfortable tap-target size. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/comparisonRangePresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Custom years input alongside the fixed presets above - same as
         ReturnsDetailActivity's own chart. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/comparisonChartWindowYears"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Custom window, years (e.g. 4.5)"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/comparisonChartWindowYearsShow"
            style="@style/ActionChip"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Show" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pinch to zoom, drag to pan, double-tap to reset. Unlocked: zooming re-bases every line to 100 at the new visible start."
        android:textSize="11sp"
        android:textColor="@color/colorNeutral" />

    </LinearLayout>

    <!-- Quantitative side-by-side comparison - built dynamically in
         ComparisonActivity as TWO separate sections (Returns, Risk
         Parameters), each its own frozen-label-column + horizontally-
         scrolling-value-columns table (TableSectionBuilder). GONE by
         default - comparisonTabGraph/comparisonTabTable toggle this
         against comparisonGraphContainer. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/comparisonTableContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/comparisonTableSectionsRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/comparisonEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:textColor="@color/colorNeutral"
        android:visibility="gone" />

</LinearLayout>
